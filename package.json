{
  "name": "codex-panel",
  "displayName": "Codexter: chat for OpenAI Codex (unofficial)",
  "description": "Unofficial chat panel for OpenAI Codex and GPT models with your ChatGPT subscription: a chat per project and git branch, tabs, history search, commit messages. Not affiliated with OpenAI.",
  "version": "0.15.0",
  "publisher": "UnrealDeveloper",
  "repository": {
    "type": "git",
    "url": "https://github.com/unreal777/codex-vscode.git"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "codex",
    "openai",
    "openai codex",
    "chatgpt",
    "gpt",
    "ai",
    "ai chat",
    "chat",
    "agent",
    "coding agent",
    "ai assistant",
    "mcp",
    "commit message",
    "git"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexPanel",
          "title": "Codexter",
          "icon": "media/codex.svg",
          "when": "codexPanel.noSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "codexPanelSecondary",
          "title": "Codexter",
          "icon": "media/codex.svg",
          "when": "!codexPanel.noSecondarySidebar"
        }
      ]
    },
    "views": {
      "codexPanel": [
        {
          "type": "webview",
          "id": "codexPanel.chat",
          "name": "Chat",
          "when": "codexPanel.noSecondarySidebar",
          "initialSize": 12
        },
        {
          "id": "codexPanel.drop",
          "name": "Attach files",
          "when": "codexPanel.noSecondarySidebar",
          "initialSize": 1
        }
      ],
      "codexPanelSecondary": [
        {
          "type": "webview",
          "id": "codexPanel.chatSecondary",
          "name": "Chat",
          "when": "!codexPanel.noSecondarySidebar",
          "initialSize": 12
        },
        {
          "id": "codexPanel.dropSecondary",
          "name": "Attach files",
          "when": "!codexPanel.noSecondarySidebar",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "codexPanel.open",
        "title": "Codexter: Open panel"
      },
      {
        "command": "codexPanel.newChat",
        "title": "Codexter: New chat",
        "icon": "$(add)"
      },
      {
        "command": "codexPanel.addToChat",
        "title": "Add to Codexter chat"
      },
      {
        "command": "codexPanel.attachFiles",
        "title": "Codexter: Attach files..."
      },
      {
        "command": "codexPanel.generateCommitMessage",
        "title": "Codexter: Generate commit message",
        "icon": {
          "light": "media/commit-light.svg",
          "dark": "media/commit-dark.svg"
        }
      },
      {
        "command": "codexPanel.askSelection",
        "title": "Codexter: Ask about selection"
      },
      {
        "command": "codexPanel.explainSelection",
        "title": "Codexter: Explain selection"
      },
      {
        "command": "codexPanel.fixSelection",
        "title": "Codexter: Fix selection"
      },
      {
        "command": "codexPanel.openSettings",
        "title": "Codexter: Open settings",
        "icon": "$(gear)"
      },
      {
        "command": "codexPanel.checkUpdates",
        "title": "Codexter: Check for Codex updates"
      },
      {
        "command": "codexPanel.review",
        "title": "Codexter: Code review"
      }
    ],
    "keybindings": [
      {
        "command": "codexPanel.open",
        "key": "ctrl+alt+c"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexPanel.newChat",
          "when": "view == codexPanel.chat || view == codexPanel.chatSecondary",
          "group": "navigation@1"
        },
        {
          "command": "codexPanel.openSettings",
          "when": "view == codexPanel.chat || view == codexPanel.chatSecondary",
          "group": "navigation@2"
        }
      ],
      "scm/title": [
        {
          "command": "codexPanel.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@0"
        }
      ],
      "explorer/context": [
        {
          "command": "codexPanel.addToChat",
          "group": "7_modification@99"
        }
      ],
      "editor/context": [
        {
          "command": "codexPanel.askSelection",
          "when": "editorHasSelection",
          "group": "9_codex@1"
        },
        {
          "command": "codexPanel.explainSelection",
          "when": "editorHasSelection",
          "group": "9_codex@2"
        },
        {
          "command": "codexPanel.fixSelection",
          "when": "editorHasSelection",
          "group": "9_codex@3"
        },
        {
          "command": "codexPanel.addToChat",
          "group": "9_codex@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "codexPanel.addToChat",
          "group": "1_codex"
        }
      ],
      "commandPalette": [
        {
          "command": "codexPanel.askSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "codexPanel.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "codexPanel.fixSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Codexter",
      "properties": {
        "codexPanel.codexPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to your own Codex executable (`codex.exe` on Windows, `codex` on macOS and Linux). Empty = use the managed copy (or `CODEX_EXECUTABLE`, npm global, `PATH`)."
        },
        "codexPanel.codexSource": {
          "type": "string",
          "enum": [
            "managed",
            "own"
          ],
          "enumDescriptions": [
            "Download and update Codex from the npm registry (shared with the Eclipse plugin).",
            "Use only the path above, CODEX_EXECUTABLE, npm global or PATH."
          ],
          "default": "managed",
          "description": "Where Codex comes from."
        },
        "codexPanel.updateIntervalDays": {
          "type": "integer",
          "minimum": 0,
          "default": 7,
          "description": "Days between automatic Codex update checks (0 = never)."
        },
        "codexPanel.autosave": {
          "type": "boolean",
          "default": true,
          "description": "Save modified editors of the workspace folder before sending a message."
        },
        "codexPanel.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model a new chat starts with. Empty = the Codex default. Can also be changed with the gear in the Codexter panel."
        },
        "codexPanel.defaultReasoningEffort": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "The model's default",
            "None",
            "Minimal",
            "Low",
            "Medium",
            "High",
            "Extra high"
          ],
          "markdownDescription": "Reasoning effort a new chat starts with. Empty = the model's default."
        },
        "codexPanel.defaultPermissions": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "ask",
            "auto",
            "full",
            "custom"
          ],
          "enumDescriptions": [
            "Keep the permissions used last",
            "Ask for approval",
            "Approve for me",
            "Full access",
            "Custom (config.toml)"
          ],
          "markdownDescription": "Permissions a new chat starts with. Empty = keep the permissions used last."
        },
        "codexPanel.commitMessageModel": {
          "type": "string",
          "default": "gpt-6-luna",
          "markdownDescription": "Model for *Generate commit message*, the AI search of the History panel and the AI chat names (a fast one is enough). Default: GPT-6-Luna. Empty = the Codex default (config.toml)."
        },
        "codexPanel.commitMessageEffort": {
          "type": "string",
          "default": "low",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "The model's default",
            "None",
            "Minimal",
            "Low",
            "Medium",
            "High",
            "Extra high"
          ],
          "markdownDescription": "Reasoning effort for *Generate commit message*, the AI search and the AI chat names. Low is fast and enough for all of them."
        },
        "codexPanel.dictation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Experimental.** Show the microphone button in the input (Windows only for now). Your words go to Codex's voice mode and come back as text in the input; nothing is sent to the chat until you send it. **Dictation uses tokens of your ChatGPT plan** (the voice mode runs a model the whole time the microphone is on). The voice mode is experimental in Codex itself, so a Codex update may break it."
        },
        "codexPanel.dictationLanguages": {
          "type": "array",
          "default": [
            "en"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ar",
              "hy",
              "be",
              "bg",
              "zh",
              "cs",
              "da",
              "nl",
              "en",
              "fi",
              "fr",
              "ka",
              "de",
              "el",
              "he",
              "hi",
              "hu",
              "id",
              "it",
              "ja",
              "kk",
              "ko",
              "no",
              "fa",
              "pl",
              "pt",
              "ro",
              "ru",
              "sr",
              "es",
              "sv",
              "th",
              "tr",
              "uk",
              "ur",
              "vi"
            ],
            "enumItemLabels": [
              "Arabic (ar)",
              "Armenian (hy)",
              "Belarusian (be)",
              "Bulgarian (bg)",
              "Chinese (zh)",
              "Czech (cs)",
              "Danish (da)",
              "Dutch (nl)",
              "English (en)",
              "Finnish (fi)",
              "French (fr)",
              "Georgian (ka)",
              "German (de)",
              "Greek (el)",
              "Hebrew (he)",
              "Hindi (hi)",
              "Hungarian (hu)",
              "Indonesian (id)",
              "Italian (it)",
              "Japanese (ja)",
              "Kazakh (kk)",
              "Korean (ko)",
              "Norwegian (no)",
              "Persian (fa)",
              "Polish (pl)",
              "Portuguese (pt)",
              "Romanian (ro)",
              "Russian (ru)",
              "Serbian (sr)",
              "Spanish (es)",
              "Swedish (sv)",
              "Thai (th)",
              "Turkish (tr)",
              "Ukrainian (uk)",
              "Urdu (ur)",
              "Vietnamese (vi)"
            ],
            "enumDescriptions": [
              "Arabic",
              "Armenian",
              "Belarusian",
              "Bulgarian",
              "Chinese",
              "Czech",
              "Danish",
              "Dutch",
              "English",
              "Finnish",
              "French",
              "Georgian",
              "German",
              "Greek",
              "Hebrew",
              "Hindi",
              "Hungarian",
              "Indonesian",
              "Italian",
              "Japanese",
              "Kazakh",
              "Korean",
              "Norwegian",
              "Persian",
              "Polish",
              "Portuguese",
              "Romanian",
              "Russian",
              "Serbian",
              "Spanish",
              "Swedish",
              "Thai",
              "Turkish",
              "Ukrainian",
              "Urdu",
              "Vietnamese"
            ]
          },
          "markdownDescription": "Languages you dictate in (English by default; an empty list = any language). Codex's voice mode has no language option, so the voice model is told these, and a phrase written in a script none of them uses (Chinese while you speak Russian) is left out instead of typed. Also in the panel: gear > *Dictation languages*."
        },
        "codexPanel.autoChatNames": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "first",
            "off"
          ],
          "enumDescriptions": [
            "After the first answer, then again every 5 answers (the name follows the topic)",
            "Once, after the first answer",
            "Never: the name is the first message until you rename the chat"
          ],
          "markdownDescription": "Chat names written by AI (the model of `#codexPanel.commitMessageModel#`, a small request on your Codex usage). A chat you renamed by hand keeps its name. The sparkle in the rename box asks for a name at any time."
        },
        "codexPanel.systemNotifications": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When a reply ends (or a chat asks for an approval) while VS Code is in the background, show a notification of the system (Windows, macOS, Linux) instead of VS Code's own. A click opens the chat."
        },
        "codexPanel.openOnStartup": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Open the Codexter panel when VS Code starts, in place of the view that was open last in that side bar (for example Copilot Chat)."
        },
        "codexPanel.instructionsSource": {
          "type": "string",
          "enum": [
            "codex",
            "codexter"
          ],
          "enumDescriptions": [
            "Codex's own instructions: `developer_instructions` of ~/.codex/config.toml (shared with the Codex CLI), edited in the gear of the panel.",
            "The instructions of `codexPanel.instructions`, only in Codexter."
          ],
          "default": "codex",
          "markdownDescription": "Whose instructions (how Codex should answer, e.g. briefly, in plain language) a new chat gets. AGENTS.md files always apply too."
        },
        "codexPanel.instructions": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Codexter's own instructions for new chats, used when `#codexPanel.instructionsSource#` is `codexter`."
        },
        "codexPanel.autoCompactTokens": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Codex summarizes (compacts) a chat when its context reaches this many tokens. 0 = Codex's own limit (about 90 % of the model's window). Smaller keeps replies faster and the limits lower; bigger keeps more details. Applies to chats opened or started afterwards. **Compact** in the panel's footer compacts the open chat at once."
        },
        "codexPanel.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "Font size of the Codexter panel in px (8-32). 0 = the font size of VS Code's own panels. Everything in the panel scales with it."
        },
        "codexPanel.hiddenModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Models that are hidden from the model picker (ids as Codex lists them). Can also be changed with the gear in the Codexter panel."
        }
      }
    }
  },
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "compile": "node scripts/sync-web.mjs && tsc -p ./",
    "test": "node --test \"out/test/*.test.js\"",
    "smoke": "node out/smoke/smoke.js",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
