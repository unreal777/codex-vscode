{
  "name": "codex-panel",
  "displayName": "Codexter (Codex Subscription Chat with better UI)",
  "description": "Codexter: Codex chat (your ChatGPT subscription) for VS Code with a better UI, in the secondary side bar.",
  "version": "0.7.2",
  "publisher": "codexpanel",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexPanel",
          "title": "Codexter",
          "icon": "media/codex.svg",
          "when": "codexPanel.noSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "codexPanelSecondary",
          "title": "Codexter",
          "icon": "media/codex.svg",
          "when": "!codexPanel.noSecondarySidebar"
        }
      ]
    },
    "views": {
      "codexPanel": [
        {
          "type": "webview",
          "id": "codexPanel.chat",
          "name": "Chat",
          "when": "codexPanel.noSecondarySidebar",
          "initialSize": 12
        },
        {
          "id": "codexPanel.drop",
          "name": "Attach files",
          "when": "codexPanel.noSecondarySidebar",
          "initialSize": 1
        }
      ],
      "codexPanelSecondary": [
        {
          "type": "webview",
          "id": "codexPanel.chatSecondary",
          "name": "Chat",
          "when": "!codexPanel.noSecondarySidebar",
          "initialSize": 12
        },
        {
          "id": "codexPanel.dropSecondary",
          "name": "Attach files",
          "when": "!codexPanel.noSecondarySidebar",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "codexPanel.open",
        "title": "Codexter: Open panel"
      },
      {
        "command": "codexPanel.newChat",
        "title": "Codexter: New chat",
        "icon": "$(add)"
      },
      {
        "command": "codexPanel.addToChat",
        "title": "Add to Codexter chat"
      },
      {
        "command": "codexPanel.attachFiles",
        "title": "Codexter: Attach files..."
      },
      {
        "command": "codexPanel.generateCommitMessage",
        "title": "Codexter: Generate commit message",
        "icon": {
          "light": "media/commit-light.svg",
          "dark": "media/commit-dark.svg"
        }
      },
      {
        "command": "codexPanel.askSelection",
        "title": "Codexter: Ask about selection"
      },
      {
        "command": "codexPanel.explainSelection",
        "title": "Codexter: Explain selection"
      },
      {
        "command": "codexPanel.fixSelection",
        "title": "Codexter: Fix selection"
      },
      {
        "command": "codexPanel.openSettings",
        "title": "Codexter: Open settings",
        "icon": "$(gear)"
      },
      {
        "command": "codexPanel.checkUpdates",
        "title": "Codexter: Check for Codex updates"
      }
    ],
    "keybindings": [
      {
        "command": "codexPanel.open",
        "key": "ctrl+alt+c"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexPanel.newChat",
          "when": "view == codexPanel.chat || view == codexPanel.chatSecondary",
          "group": "navigation@1"
        },
        {
          "command": "codexPanel.openSettings",
          "when": "view == codexPanel.chat || view == codexPanel.chatSecondary",
          "group": "navigation@2"
        }
      ],
      "scm/title": [
        {
          "command": "codexPanel.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@0"
        }
      ],
      "explorer/context": [
        {
          "command": "codexPanel.addToChat",
          "group": "7_modification@99"
        }
      ],
      "editor/context": [
        {
          "command": "codexPanel.askSelection",
          "when": "editorHasSelection",
          "group": "9_codex@1"
        },
        {
          "command": "codexPanel.explainSelection",
          "when": "editorHasSelection",
          "group": "9_codex@2"
        },
        {
          "command": "codexPanel.fixSelection",
          "when": "editorHasSelection",
          "group": "9_codex@3"
        },
        {
          "command": "codexPanel.addToChat",
          "group": "9_codex@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "codexPanel.addToChat",
          "group": "1_codex"
        }
      ],
      "commandPalette": [
        {
          "command": "codexPanel.askSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "codexPanel.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "codexPanel.fixSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Codexter",
      "properties": {
        "codexPanel.codexPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `codex.exe`. Empty = use the managed copy (or `CODEX_EXECUTABLE`, npm global, `PATH`)."
        },
        "codexPanel.codexSource": {
          "type": "string",
          "enum": [
            "managed",
            "own"
          ],
          "enumDescriptions": [
            "Download and update Codex from the npm registry (shared with the Eclipse plugin).",
            "Use only the path above, CODEX_EXECUTABLE, npm global or PATH."
          ],
          "default": "managed",
          "description": "Where Codex comes from."
        },
        "codexPanel.updateIntervalDays": {
          "type": "integer",
          "minimum": 0,
          "default": 7,
          "description": "Days between automatic Codex update checks (0 = never)."
        },
        "codexPanel.autosave": {
          "type": "boolean",
          "default": true,
          "description": "Save modified editors of the workspace folder before sending a message."
        },
        "codexPanel.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model a new chat starts with. Empty = the Codex default. Can also be changed with the gear in the Codexter panel."
        },
        "codexPanel.defaultReasoningEffort": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "The model's default",
            "None",
            "Minimal",
            "Low",
            "Medium",
            "High",
            "Extra high"
          ],
          "markdownDescription": "Reasoning effort a new chat starts with. Empty = the model's default."
        },
        "codexPanel.defaultPermissions": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "ask",
            "auto",
            "full",
            "custom"
          ],
          "enumDescriptions": [
            "Keep the permissions used last",
            "Ask for approval",
            "Approve for me",
            "Full access",
            "Custom (config.toml)"
          ],
          "markdownDescription": "Permissions a new chat starts with. Empty = keep the permissions used last."
        },
        "codexPanel.commitMessageModel": {
          "type": "string",
          "default": "gpt-6-luna",
          "markdownDescription": "Model for *Generate commit message* and the AI search of the History panel (a fast one is enough). Default: GPT-6-Luna. Empty = the Codex default (config.toml)."
        },
        "codexPanel.commitMessageEffort": {
          "type": "string",
          "default": "low",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "The model's default",
            "None",
            "Minimal",
            "Low",
            "Medium",
            "High",
            "Extra high"
          ],
          "markdownDescription": "Reasoning effort for *Generate commit message* and the AI search. Low is fast and enough for both."
        },
        "codexPanel.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "Font size of the Codexter panel in px (8-32). 0 = the font size of VS Code's own panels. Everything in the panel scales with it."
        },
        "codexPanel.hiddenModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Models that are hidden from the model picker (ids as Codex lists them). Can also be changed with the gear in the Codexter panel."
        }
      }
    }
  },
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "compile": "node scripts/sync-web.mjs && tsc -p ./",
    "test": "node --test \"out/test/*.test.js\"",
    "smoke": "node out/smoke/smoke.js",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
